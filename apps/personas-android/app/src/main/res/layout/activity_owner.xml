<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:padding="8dp">

        <Button
            android:id="@+id/exportPrefs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_prefs" />

        <Button
            android:id="@+id/importPrefs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_prefs" />

        <Button
            android:id="@+id/openSites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_sites" />

        <Button
            android:id="@+id/reloadOwner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reload_owner" />
    </LinearLayout>

    <WebView
        android:id="@+id/ownerWeb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
