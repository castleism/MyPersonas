# Root guard: personal working material must never enter the repo, even via
# a careless `git add -A`. push.ps1 already scopes its add (line 29), but this
# makes the protection unconditional.
/outputs/
/_to_delete/
/*-ROADMAP-PROMPT.md
/*-PERSONA-PROMPT*.md
/*-DOSSIER*.md
*.bak

# Dev tooling / OS junk — never commit
/node_modules/
/supabase/.branches/
/supabase/.temp/
.DS_Store
Thumbs.db

# Android debug companion — local SDK path and Gradle outputs only
/apps/personas-android/local.properties
/apps/personas-android/.gradle/
/apps/personas-android/app/build/
/apps/personas-android/build/

# Local-only mobile development artifacts
**/node_modules/
**/.gradle/
**/.cxx/
**/local.properties
**/key.properties
*.keystore
*.jks
*.apk
*.aab
.env
.env.*
phone-cleanup-backup/
